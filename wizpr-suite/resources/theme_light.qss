QWidget { font-family: "Segoe UI"; font-size: 10.25pt; color: #152131; background: #eef4f8; }
QFrame#sidebar { background: #e4edf4; border-right: 1px solid #b7cad9; }
QFrame#mainSurface { background: #f4f8fb; }
QFrame#appHeader, QFrame#conversationCard, QFrame#composerCard, QFrame#settingsCard, QFrame#ringCard {
  background: #ffffff; border: 1px solid #bfd0dd; border-radius: 11px;
}
QLabel#headerTitle { color: #087bbd; font-size: 19pt; font-weight: 700; }
QLabel#headerSubtitle, QLabel#settingsSubtitle, QLabel#sectionSubtitle { color: #607386; }
QPushButton#navButton { text-align: left; min-height: 38px; padding: 0 12px; background: transparent; border: 1px solid transparent; border-radius: 8px; color: #42576a; }
QPushButton#navButton:checked { background: #d7ecf9; border-color: #6ab4df; color: #087bbd; font-weight: 700; }
QPushButton { min-height: 30px; background: #ffffff; border: 1px solid #b7cad8; border-radius: 7px; padding: 4px 10px; }
QPushButton:hover { background: #e9f5fc; border-color: #55a9d8; }
QPushButton#primaryButton { background: #158bd0; border-color: #0877b8; color: white; font-weight: 700; }
QPushButton#micButton { background: #d9f1ff; border: 2px solid #1498df; border-radius: 29px; color: #087bbd; font-size: 22pt; }
QLineEdit, QPlainTextEdit, QTextEdit, QTextBrowser, QComboBox, QSpinBox, QDoubleSpinBox { background: #ffffff; border: 1px solid #b8cbd9; border-radius: 7px; padding: 6px 8px; color: #152131; }
QTextBrowser#conversationView { background: #f7fafc; }
QListWidget#settingsNav { background: #e7eff5; border: 0; border-right: 1px solid #b9cad7; padding: 12px 8px; }
QListWidget#settingsNav::item { min-height: 39px; padding: 0 10px; margin: 2px 0; border-radius: 7px; }
QListWidget#settingsNav::item:selected { background: #cfeafb; color: #087bbd; }
QWidget#settingsPage, QStackedWidget#settingsStack { background: #f4f8fb; }
QLabel#settingsTitle, QLabel#sectionTitle { font-size: 17pt; font-weight: 700; }
QStatusBar { background: #e5eef5; border-top: 1px solid #b7cad8; }
